{
  "name": "windows-island",
  "version": "0.3.5",
  "description": "A quiet, beautifully animated desktop island for Windows",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Windows Island",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/icon.mjs && npm run build:native && tsc -b && vite build && node scripts/check-production.mjs && npm run build:mcp",
    "build:native": "node scripts/build-native.cjs",
    "build:mcp": "esbuild mcp/server.mjs --bundle --platform=node --format=cjs --outfile=mcp/dist/server.cjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win portable",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:native-focus": "npm run build:native && powershell -NoProfile -ExecutionPolicy Bypass -File tests/native-focus.ps1",
    "test:native-system": "npm run build:native && node tests/native-system.mjs",
    "mcp": "node mcp/server.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "capture:demo": "node scripts/capture-demo.mjs",
    "measure:memory": "node scripts/measure-memory.mjs",
    "test:overlay": "node tests/overlay-smoke.mjs",
    "test:recording": "node tests/recording-smoke.mjs",
    "test:native-clipboard": "npm run build:native && powershell -NoProfile -ExecutionPolicy Bypass -File tests/native-clipboard.ps1",
    "test:appearance": "node tests/appearance-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.1.2",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "compression": "normal",
    "appId": "app.windowsisland.desktop",
    "productName": "Windows Island",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin/IslandBridge.exe",
        "to": "native/IslandBridge.exe"
      },
      {
        "from": "mcp/dist/server.cjs",
        "to": "mcp/server.cjs"
      }
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "electron/assets/icon.ico"
    },
    "portable": {
      "artifactName": "Windows-Island-${version}.exe"
    }
  }
}
